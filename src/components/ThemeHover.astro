---
// Hovering or focusing a project card previews that project's theme on the whole page.
// Tokens are @property-registered, so the html transition in global.css animates them
// (and reduced motion already disables that transition, making the swap instant).
---
<script>
  const root = document.documentElement;
  const keys = ['accent', 'accent2', 'bg'] as const;
  const original = Object.fromEntries(keys.map((k) => [k, root.style.getPropertyValue(`--${k}`)]));
  let revertTimer = 0;

  const apply = (card: HTMLElement) => {
    clearTimeout(revertTimer);
    for (const k of keys) {
      const v = card.dataset[k];
      if (v) root.style.setProperty(`--${k}`, v);
    }
  };
  const revertNow = () => {
    clearTimeout(revertTimer);
    for (const k of keys) original[k] ? root.style.setProperty(`--${k}`, original[k]) : root.style.removeProperty(`--${k}`);
  };
  // Short delay so moving between adjacent cards doesn't flash back to the base theme.
  const revert = () => { clearTimeout(revertTimer); revertTimer = window.setTimeout(revertNow, 120); };

  for (const card of document.querySelectorAll<HTMLElement>('a.card[data-accent]')) {
    card.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') apply(card); });
    card.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch' && document.activeElement !== card) revert(); });
    card.addEventListener('focus', () => apply(card));
    card.addEventListener('blur', revert);
  }
  // Coming back via bfcache should not keep a previewed theme.
  window.addEventListener('pageshow', (e) => { if (e.persisted) revertNow(); });
</script>
