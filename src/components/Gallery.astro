---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import media from '../../content/media.json';

interface Props { ids: string[] }
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp}', { eager: true });
const items = Astro.props.ids
  .map((id) => media.find((m) => m.id === id))
  .filter((m): m is (typeof media)[number] => Boolean(m));
---
{items.length > 0 && (
  <section class="gallery" aria-label="Media">
    {items.map((m) => (
      <figure class={m.type === 'video' ? 'wide' : undefined}>
        {m.type === 'video' ? (
          <video src={m.src} poster={(m as { poster?: string }).poster} autoplay muted loop playsinline preload="metadata" aria-label={m.alt} data-motion></video>
        ) : m.type === 'image' && assets['/' + m.src] ? (
          <a href={assets['/' + m.src].default.src} target="_blank" rel="noopener">
            <Image src={assets['/' + m.src].default} alt={m.alt} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 480px" loading="lazy" />
          </a>
        ) : null}
        <figcaption><strong>{m.title}.</strong> {m.caption}</figcaption>
      </figure>
    ))}
  </section>
)}
<script>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.querySelectorAll<HTMLVideoElement>('video[data-motion]').forEach((v) => { v.pause(); v.removeAttribute('autoplay'); v.controls = true; });
</script>
<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1rem; margin-block: 2rem; max-width: 60rem; }
  figure { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  figure.wide { grid-column: 1 / -1; }
  figure img, figure video { display: block; width: 100%; height: auto; background: #fff; }
  figure.wide video { max-height: 22rem; object-fit: contain; background: #000; }
  figcaption { padding: .6rem .8rem; font-size: .85rem; color: var(--muted); }
  figcaption strong { color: var(--fg); font-weight: 600; }
</style>
