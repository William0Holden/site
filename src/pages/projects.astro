---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThemeHover from '../components/ThemeHover.astro';
import { getProjects, getSite } from '../lib';
const projects = await getProjects();
const site = await getSite();
const { Content: Bio } = await render(site);
---
<Base title="Work" description="Professional, research, and personal projects by William O. Holden.">
  <p class="eyebrow">Work</p>
  <h1>Things I've built</h1>
  <div class="prose bio"><Bio /></div>
  <div class="grid">{projects.map((p) => <ProjectCard project={p} level={2} />)}</div>
  <ThemeHover />
</Base>
<style>.bio { color: var(--muted); margin-bottom: 1.5rem; }</style>
