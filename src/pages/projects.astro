---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThemeHover from '../components/ThemeHover.astro';
import { getProjects } from '../lib';
const projects = await getProjects();
---
<Base title="Projects" description="Professional, research, and personal projects by William O. Holden.">
  <p class="eyebrow">Projects</p>
  <h1>Things I've built</h1>
  <div class="grid">{projects.map((p) => <ProjectCard project={p} level={2} />)}</div>
  <ThemeHover />
</Base>
