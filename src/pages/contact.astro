---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib';
const site = await getSite();
---
<Base title="Contact">
  <article class="prose">
    <p class="eyebrow">Contact</p>
    <h1>Say hello</h1>
    <p class="lede">The fastest way to reach me is email.</p>
    <p><a class="btn" href="mailto:williamhold02@gmail.com">williamhold02@gmail.com</a></p>
    <ul>{site.data.links.filter((l) => !l.url.startsWith('mailto')).map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
  </article>
</Base>
