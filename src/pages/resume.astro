---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib';
const projects = await getProjects();
const pick = (slug: string) => projects.find((p) => p.data.slug === slug)!;
---
<Base title="Resume" description="Resume of William O. Holden, AI Engineer.">
  <article class="prose">
    <p class="eyebrow">Resume</p>
    <h1>William O. Holden</h1>
    <p><a class="btn" href="/resume.pdf">Download PDF</a></p>

    <h2>Experience</h2>
    <h3>Aderant · AI Engineer, Docketing &amp; VI Engineering</h3>
    <p class="lede">Dec 2025 – present · Atlanta, GA (hybrid)</p>
    <p>{pick('aderant').data.summary} <a href="/p/aderant">Details →</a></p>
    <h3>University of Georgia, School of Computing · Graduate Research Assistant, Computer Vision</h3>
    <p class="lede">2024 – Dec 2025 · Athens, GA</p>
    <p>{pick('broiler-behavior').data.summary} <a href="/p/broiler-behavior">Details →</a></p>

    <h2>Selected projects</h2>
    <ul>
      {['decktection', 'whisper-optimization', 'cinema-ebooking'].map((s) => (
        <li><a href={`/p/${s}`}>{pick(s).data.title}</a>: {pick(s).data.summary}</li>
      ))}
    </ul>

    <h2>Publication</h2>
    <p>Holden, W.O., Li, G., Agyemang-Duah, E., et al. "Spatiotemporal video encoder integrated with metadata fusion for action recognition and behavior analysis." <em>Computers and Electronics in Agriculture</em> 253 (2026), 112159. <a href="https://doi.org/10.1016/j.compag.2026.112159">doi:10.1016/j.compag.2026.112159</a></p>

    <h2>Education</h2>
    <ul>
      <li>M.S. Artificial Intelligence, University of Georgia, Dec 2025 (GPA 3.73)</li>
      <li>B.S. Computer Science, UGA Honors Program, Presidential Scholar, Dean's List, Dec 2024</li>
    </ul>
  </article>
</Base>
