---
import Base from '../layouts/Base.astro';
import { getProjects, getSite } from '../lib';
const projects = await getProjects();
const site = await getSite();
const pick = (slug: string) => projects.find((p) => p.data.slug === slug)!;
---
<Base title="Resume" description="Resume of William O. Holden, AI Engineer.">
  <article class="prose">
    <p class="eyebrow">Resume</p>
    <h1>William O. Holden</h1>
    <p><a class="btn" href="/resume.pdf">Download PDF</a></p>

    <h2>Experience</h2>
    <h3>Aderant · AI Engineer</h3>
    <p class="lede">Dec 2025 – present · Atlanta, GA (hybrid)</p>
    <p>{pick('aderant').data.summary} <a href="/p/aderant">Details →</a></p>
    <h3>University of Georgia, School of Computing · Graduate Research Assistant, Computer Vision</h3>
    <p class="lede">2024 – Dec 2025 · Athens, GA</p>
    <p>{pick('broiler-behavior').data.summary} <a href="/p/broiler-behavior">Details →</a></p>

    <h2>Selected projects</h2>
    <ul>
      {['decktection', 'whisper-optimization', 'mt-evaluation', 'qts', 'cinema-ebooking', 'homelab'].map((s) => (
        <li><a href={`/p/${s}`}>{pick(s).data.title}</a>: {pick(s).data.summary}</li>
      ))}
    </ul>

    <h2>Publication</h2>
    <p>Holden, W.O., Li, G., Agyemang-Duah, E., et al. "Spatiotemporal video encoder integrated with metadata fusion for action recognition and behavior analysis." <em>Computers and Electronics in Agriculture</em> 253 (2026), 112159. <a href="https://doi.org/10.1016/j.compag.2026.112159">doi:10.1016/j.compag.2026.112159</a></p>

    <h2>Education</h2>
    <ul>
      <li>M.S. Artificial Intelligence, University of Georgia, Dec 2025 (GPA 3.73)</li>
      <li>B.S. Computer Science, UGA Honors Program, Presidential Scholar, Dean's List, Dec 2024</li>
    </ul>

    <h2>Awards</h2>
    <ul>{site.data.awards.map((a) => <li>{a}</li>)}</ul>

    <h2>Earlier experience &amp; leadership</h2>
    <ul>
      <li><strong>Resident Assistant</strong>, UGA Housing (Jul 2022 – Dec 2025): responsible for communities of 30–75 residents, from community building to crisis response.</li>
      <li><strong>Programming Coordinator</strong>, Be The Match UGA: ran bone-marrow donor registration drives and awareness events.</li>
      <li><strong>Counselor</strong>, Camp Kesem (2023): camp for kids whose family members have cancer.</li>
      <li><strong>Billing Specialist</strong>, MSN Health Solutions (2021–2023, remote): medical billing, patient records, and ledgers.</li>
    </ul>

    <h2>Skills</h2>
    <ul>
      <li><strong>Languages:</strong> Python, TypeScript/JavaScript, Java, C++, C, SQL, R</li>
      <li><strong>AI &amp; ML:</strong> agentic workflows and LLM orchestration, RAG, vector search, PyTorch, TensorFlow, scikit-learn, OpenCV, YOLO, SAM, ONNX</li>
      <li><strong>Cloud &amp; DevOps:</strong> AWS, Terraform, Flux GitOps, Docker, Grafana, GitHub Actions</li>
      <li><strong>Web &amp; data:</strong> React, Node.js, Django, PostgreSQL, MongoDB</li>
      <li><strong>Tools:</strong> Glean, Browserbase, Playwright, Postman</li>
    </ul>

    <h2 id="contact">Contact</h2>
    <p>{site.data.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.url}>{l.label === 'Email' ? l.url.replace('mailto:', '') : l.label}</a></>)}</p>
  </article>
</Base>
