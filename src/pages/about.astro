---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSite } from '../lib';
const site = await getSite();
const { Content } = await render(site);
---
<Base title="About">
  <article class="prose">
    <p class="eyebrow">About</p>
    <h1>Hi, I'm William.</h1>
    <Content />
    <h2>Education</h2>
    <ul>
      <li><strong>M.S. Artificial Intelligence</strong>, University of Georgia, Dec 2025 (GPA 3.73)</li>
      <li><strong>B.S. Computer Science</strong>, UGA Honors Program, Presidential Scholar, Dean's List, Dec 2024</li>
    </ul>
    <h2>Skills</h2>
    <ul>
      <li><strong>Languages:</strong> Python, TypeScript/JavaScript, Java, C++, C, SQL, R</li>
      <li><strong>AI &amp; ML:</strong> agentic workflows and LLM orchestration, RAG, vector search, PyTorch, TensorFlow, scikit-learn, OpenCV, YOLO, SAM, ONNX</li>
      <li><strong>Cloud &amp; DevOps:</strong> AWS, Terraform, Flux GitOps, Docker, Grafana, GitHub Actions</li>
      <li><strong>Web &amp; data:</strong> React, Node.js, Django, PostgreSQL, MongoDB</li>
      <li><strong>Tools:</strong> Glean, Browserbase, Playwright, Postman</li>
    </ul>
  </article>
</Base>
