---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---
<Base title={data.title} description={data.summary} theme={data.theme}>
  <article class="prose">
    <p class="eyebrow">{data.kind.replace('-', ' ')} · {data.period}</p>
    <h1 style={`view-transition-name:title-${data.slug}`}>{data.title}</h1>
    {data.role && <p class="lede">{data.role}</p>}
    <p class="lede">{data.summary}</p>
    <ul class="chips" aria-label="Stack">{data.stack.map((s) => <li>{s}</li>)}</ul>
    <Content />
    {data.links.length > 0 && (
      <p>{data.links.map((l) => <a class="btn" href={l.url} rel="noopener">{l.label}</a>)}</p>
    )}
    <p><a href="/projects">← All projects</a></p>
  </article>
</Base>
