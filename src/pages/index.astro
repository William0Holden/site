---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroField from '../components/HeroField.astro';
import { getProjects, getSite } from '../lib';
import headshot from '../assets/headshot.jpg';
import Chat from '../chat/Chat';

const site = await getSite();
const { Content: Bio } = await render(site);
const projects = await getProjects();
---
<Base>
  <section class="intro">
    <HeroField />
    <Image src={headshot} alt="Headshot of William O. Holden" width={120} height={173} loading="eager" class="headshot" />
    <div>
      <h1>{site.data.name}</h1>
      <p class="lede">{site.data.role} · {site.data.location}. Ask me anything about my work, or jump to <a href="/projects">my work</a>, <a href="/resume">resume</a>, or the <a href="/terminal">terminal</a>.</p>
    </div>
  </section>
  <Chat client:load variant="page" />
  <noscript>
    <div class="prose">
      <Bio />
      <h2>Work</h2>
      <ul>{projects.map((p) => <li><a href={`/p/${p.data.slug}`}>{p.data.title}</a> ({p.data.period})</li>)}</ul>
      <p><a href="/resume">Resume</a> · or from a shell: <span class="mono">curl wholden.com</span></p>
    </div>
  </noscript>
</Base>
<style>
  .intro { position: relative; isolation: isolate; display: flex; gap: 1.25rem; align-items: center; padding-block: .5rem 1.25rem; }
  .intro h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .35rem; }
  .intro .lede { margin: 0; font-size: 1.02rem; }
  .headshot { border-radius: 16px; border: 1px solid var(--border); width: 88px; height: auto; flex: none; }
  @media (max-width: 640px) { .headshot { width: 64px; } }
</style>
