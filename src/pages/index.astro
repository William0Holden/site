---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProjects, getSite } from '../lib';
import Terminal from '../term/Terminal';

const site = await getSite();
const { Content: Bio } = await render(site);
const projects = await getProjects();
const s = site.data;
---
<Base>
  <Terminal client:load />
  <noscript>
    <main class="static">
      <h1>{s.name}</h1>
      <p>{s.role} · {s.location}</p>
      <Bio />
      <h2>Experience</h2>
      <ul>{s.experience.map((e) => <li><strong>{e.title}</strong>, {e.org}{e.period && ` (${e.period})`}{e.summary && `: ${e.summary}`}</li>)}</ul>
      <h2>Projects</h2>
      <ul>{projects.map((p) => <li><strong>{p.data.title}</strong> ({p.data.period}): {p.data.summary} {p.data.links.map((l) => <><a href={l.url}>{l.label}</a> </>)}</li>)}</ul>
      <h2>Education</h2>
      <ul>{s.education.map((e) => <li>{e.degree}, {e.school}, {e.date}{e.detail && ` (${e.detail})`}</li>)}</ul>
      <h2>Publication</h2>
      <ul>{s.publications.map((p) => <li>{p.cite} {p.doi && <a href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>}</li>)}</ul>
      <h2>Awards</h2>
      <ul>{s.awards.map((a) => <li>{a}</li>)}</ul>
      <h2>Skills</h2>
      <ul>{s.skills.map((k) => <li><strong>{k.area}:</strong> {k.items.join(', ')}</li>)}</ul>
      <h2>Contact</h2>
      <p>{s.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.url}>{l.label === 'Email' ? l.url.replace('mailto:', '') : l.label}</a></>)} · <a href="/resume.pdf">Resume (PDF)</a></p>
      <p>This site is a terminal and needs JavaScript. From any shell: <code>curl wholden.com</code></p>
    </main>
  </noscript>
</Base>
<style>
  .static { max-width: 46rem; padding: 2rem 16px; font-family: system-ui, sans-serif; }
</style>
