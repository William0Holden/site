{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wholden-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Dashboard-set vars/secrets survive deploys.
  "keep_vars": true,
  // Always build, even if the Workers Builds dashboard has no build command.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Worker runs first only where it adds behaviour: curl on these paths, /api, /mcp.
    "run_worker_first": ["/", "/help", "/projects", "/resume", "/p/*", "/contact", "/api/*", "/mcp"]
  },
  "routes": [{ "pattern": "wholden.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
