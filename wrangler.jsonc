{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wholden-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Lets the chat stop generating (and spending) when the visitor disconnects.
  "compatibility_flags": ["enable_request_signal"],
  // Dashboard-set vars/secrets survive deploys.
  "keep_vars": true,
  // Always build, even if the Workers Builds dashboard has no build command.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Worker runs first for pages/APIs (https redirect + HSTS, curl, /api, /mcp, /unlock); static
    // files skip it so they don't count against the Workers request quota.
    "run_worker_first": ["/*", "!/_astro/*", "!/media/*", "!/resume.pdf", "!/favicon.svg", "!/v86/*"]
  },
  // Rate limits + global daily LLM budget (SQLite-backed Durable Object, free tier).
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
  // Contact messages from visitors, delivered only to William's verified Email Routing address.
  "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["williamhold02@gmail.com"] }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  "routes": [{ "pattern": "wholden.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
